EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Optional: Privacy policy URL (shows a button in Settings)
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy

# Firebase Hosting privacy page variables (used by scripts/prepare-privacy.js)
# Required in production deploys
FAMLY_PRIVACY_CONTACT_EMAIL=support@example.com
# Optional operator/company name (section hidden if empty)
FAMLY_OPERATOR_NAME=
