{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "// include": "テストも型チェック対象に含める。ビルド時の除外は tsconfig.build.json 側で行う。",
  "include": ["src"]
}

