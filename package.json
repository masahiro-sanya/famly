{
  "name": "famly",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-famly \"jest --config jest.rules.config.js\"",
    "typecheck": "tsc --noEmit",
    "prepare:privacy": "node scripts/prepare-privacy.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "firebase": "^12.9.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-paper": "^5.15.4",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  },
  "overrides": {
    "@grpc/grpc-js": "~1.13.6",
    "glob@^13.0.0": "^14.0.2",
    "minimatch@^10.0.0": "^11.0.1"
  }
}
